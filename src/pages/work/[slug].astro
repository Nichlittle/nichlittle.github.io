---
// One page per Markdown file in src/content/projects/.
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => import.meta.env.DEV || !data.draft);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={project.data.title} description={project.data.summary}>
  <article class="project">
    <p class="kicker">// selected work</p>
    <h1>{project.data.title}</h1>
    <p class="lead">{project.data.summary}</p>
    <div class="prose">
      <Content />
    </div>
    <p class="meta back"><a href={`${base}/`}>← all work</a></p>
  </article>
</Base>
