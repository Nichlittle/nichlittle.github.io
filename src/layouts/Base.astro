---
// The frame every page sits in: head, header, footer.
import '../styles/global.css';
import { SITE_NAME, LINKEDIN } from '../site';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean; // the home page uses a wider column for its grids
}
const {
  title,
  description = 'Nick Little: marketing leader for connected-vehicle and public-safety tech, who builds the AI systems his team runs on.',
  wide = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(base, '') || '/';
const pageTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME} · Nick Little`;
const wrap = wide ? 'wrap wrap-wide' : 'wrap';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0910" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600&family=JetBrains+Mono:wght@400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
    />
  </head>
  <body>
    <div class="topline">
      <div class={wrap}>
        You can contact me through my <a href={LINKEDIN} target="_blank" rel="noopener">LinkedIn</a>.
      </div>
    </div>
    <header class="site-header">
      <div class={wrap}>
        <a class="logo" href={`${base}/`}><span class="dot status-dot"></span>{SITE_NAME}</a>
        <nav>
          <a href={`${base}/#work`} aria-current={path.startsWith('/work') ? 'page' : undefined}>work</a>
          <a href={`${base}/#experience`}>experience</a>
          <a href={`${base}/about/`} aria-current={path.startsWith('/about') ? 'page' : undefined}>about</a>
        </nav>
      </div>
    </header>
    <hr class="rule" />
    <main>
      <div class={wrap}>
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <hr class="rule" />
      <div class={wrap}>
        <p class="meta">Built by Nick, with AI, in public. Written in Markdown, shipped with Git.</p>
      </div>
    </footer>
  </body>
</html>
