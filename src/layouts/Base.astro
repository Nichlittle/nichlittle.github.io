---
// The frame every page sits in: head, header, footer.
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = 'A build log by a marketer who builds real AI systems.' } = Astro.props;

const SITE_NAME = 'Signal Log'; // placeholder name — change in one place
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(base, '') || '/';
const pageTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0910" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600&family=JetBrains+Mono:wght@400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href={`${base}/`}><span class="dot"></span>{SITE_NAME}</a>
        <nav>
          <a href={`${base}/`} aria-current={path === '/' ? 'page' : undefined}>log</a>
          <a href={`${base}/about/`} aria-current={path.startsWith('/about') ? 'page' : undefined}>about</a>
        </nav>
      </div>
    </header>
    <hr class="rule" />
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <hr class="rule" />
      <div class="wrap">
        <p class="meta">Built by Nick, with AI, in public. Written in Markdown, shipped with Git.</p>
      </div>
    </footer>
  </body>
</html>
